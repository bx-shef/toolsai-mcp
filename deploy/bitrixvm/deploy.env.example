# Настройки автообновления: /home/bitrix/mcp/deploy.env (владелец bitrix, 600).
# Читает ~/mcp/bin/mcp-deploy (make install, cron bitrix). Порядок — docs/DEPLOY_BITRIXVM.md.

STACK_DIR=/home/bitrix/mcp
GIT_BRANCH=main
# Образ без тега: тег sha-<коммит> подставляет скрипт
IMAGE=ghcr.io/bx-shef/toolsai-mcp
# Тот же порт, что MCP_PORT в /home/bitrix/mcp/.env
MCP_PORT=3100

# Проверка после перезапуска: попыток × интервал (с)
HEALTH_ATTEMPTS=24
HEALTH_INTERVAL_SEC=5

# Только если пакет GHCR сделают закрытым: classic PAT со scope read:packages, файл chmod 600
# REGISTRY_USER=bx-shef
# REGISTRY_TOKEN_FILE=/home/bitrix/mcp/registry_token
