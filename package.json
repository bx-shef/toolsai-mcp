{
  "name": "toolsai-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "smoke": "node smoke/observe.mjs",
    "typecheck": "nuxt prepare && tsc --noEmit -p server/tsconfig.json",
    "docs:bitrix": "mkdir -p .bitrix-docs && (test -d .bitrix-docs/b24-rest-docs/.git && git -C .bitrix-docs/b24-rest-docs pull -q --depth 1 || git clone -q --depth 1 https://github.com/bitrix-tools/b24-rest-docs.git .bitrix-docs/b24-rest-docs)"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bitrix24/b24jssdk": "3.0.0",
    "@nuxtjs/mcp-toolkit": "0.24.2",
    "ioredis": "5.11.1",
    "nuxt": "4.6.1",
    "unstorage": "1.17.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
