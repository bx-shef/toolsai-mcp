# /home/bitrix/mcp/.env на сервере (владелец bitrix, 600). Устройство — docs/ARCHITECTURE.md.

# Адрес сервера, как его видят клиенты (без слэша на конце): путь на портале через nginx
# или свой домен, если сервер обслуживает любые Битрикс24
PUBLIC_URL=https://portal.example/mcp-ai
# Приложение Битрикс24. Один портал — локальное приложение («Разработчикам → Другое → Локальное
# приложение»). Любые Битрикс24 (облако и коробки) — приложение из партнёрского кабинета: его
# client_id действует на каждом портале, где приложение установлено. Адрес портала сотрудник
# вводит при входе; REST идёт на адрес, который вернул OAuth-сервер Битрикс24.
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Необязательно: портал по умолчанию — подставляется в поле входа, к нему относятся голые ID
# в ALLOWED_USERS
# B24_PORTAL_URL=https://portal.example
# OAuth-серверы Битрикс24, которым верим (первый — по умолчанию)
# B24_OAUTH_SERVERS=https://oauth.bitrix.info,https://oauth.bitrix24.tech

# Ключ шифрования токенов Битрикс24 в Redis: openssl rand -base64 32
# Сменили — все сотрудники входят заново.
ENCRYPTION_KEY=

# Обязательно: кому открыт вход, через запятую.
#   *                        — всем сотрудникам любого портала, где стоит приложение
#   mycompany.bitrix24.by    — всем сотрудникам этого портала
#   mycompany.bitrix24.by:7  — сотруднику 7 этого портала
#   7                        — сотруднику 7 портала по умолчанию (нужен B24_PORTAL_URL)
ALLOWED_USERS=portal.example:1

# Пароль Redis (его читает и docker compose): openssl rand -hex 24
REDIS_PASSWORD=

# Жизнь наших токенов для клиентов, с (целое, не меньше 60)
# ACCESS_TTL_SEC=3600
# REFRESH_TTL_SEC=2592000

# Порт на 127.0.0.1 (его проксирует nginx) и лимиты контейнера
MCP_PORT=3100
# MCP_CPUS=1
# MCP_MEM_LIMIT=512m
